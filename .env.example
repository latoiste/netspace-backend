# Copy this file to ".env" and fill in real values. Do NOT commit ".env".
#
# PostgreSQL connection string (pq format).
# Example for a local DB named "netspace":
DB_CONN_STRING=postgres://postgres:postgres@localhost:5432/netspace?sslmode=disable

# Secret used to sign user-session JWTs. Any non-empty string works for dev.
JWT_SECRET_KEY=dev-secret-change-me
